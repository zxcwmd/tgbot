# Токен бота от @BotFather. На justrunmy.app задаётся в панели как переменная окружения.
TELEGRAM_BOT_TOKEN=

# Telegram ID админов через запятую. Узнать свой ID: запусти бота и напиши ему /id
ADMIN_IDS=

# Необязательно: где хранить базу подписчиков (по умолчанию data/bot.db)
